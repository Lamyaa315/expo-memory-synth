# Data & outputs (heavy files stay out of git)
data/*
!data/.gitkeep
*.mp4
*.mov
results/
outputs/
web/**/*.ply
web/**/*.splat
# the scene the deployed site shows: in Git LFS (.gitattributes)
!web/scenes/corner/scene.splat
!web/scenes/corner/kingdoms.splat
!web/scenes/corner/scene-lite.splat
!web/scenes/corner/kingdoms-lite.splat
web/**/*.ksplat
web/audio/*.mp3
!web/audio/.gitkeep

# Python
__pycache__/
*.pyc
.venv/
.env
.ipynb_checkpoints/
.venv-voice/

